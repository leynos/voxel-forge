{
  "name": "voxel-forge-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run serve.ts",
    "fmt": "biome format --write .",
    "check:fmt": "biome check --formatter-enabled=true --linter-enabled=false .",
    "lint": "bun run lint:biome && bun run lint:oxlint",
    "lint:biome": "biome lint .",
    "lint:oxlint": "oxlint .",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.1",
    "@types/three": "^0.175.0",
    "bun-types": "^1.2.0",
    "df12-lints": "github:leynos/df12-lints",
    "oxlint": "^1.66.0",
    "typescript": "^5.8.2"
  }
}
